      "type": 1,
      "content": "也有点",
      "delay": 0,
      "next": "1-12_msg_015"
    },
    {
      "id": "1-12_msg_015",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-12_msg_016"
    },
    {
      "id": "1-12_msg_016",
      "type": 1,
      "content": "期待",
      "delay": 0,
      "next": "1-12_msg_017"
    },
    {
      "id": "1-12_msg_017",
      "type": 1,
      "content": "期待",
      "delay": 0,
      "next": "1-12_msg_018"
    },
    {
      "id": "1-12_msg_018",
      "type": 1,
      "content": "就是",
      "delay": 0,
      "next": "1-12_msg_019"
    },
    {
      "id": "1-12_msg_019",
      "type": 1,
      "content": "有人约我",
      "delay": 0,
      "next": "1-12_msg_020"
    },
    {
      "id": "1-12_msg_020",
      "type": 1,
      "content": "有人想到我",
      "delay": 0,
      "next": "1-12_msg_021"
    },
    {
      "id": "1-12_msg_021",
      "type": 1,
      "content": "有人",
