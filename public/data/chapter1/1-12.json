      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-12_msg_010"
    },
    {
      "id": "1-12_msg_010",
      "type": 1,
      "content": "\"听说挺好看的，同事一起逛逛\"",
      "delay": 0,
      "next": "1-12_msg_011"
    },
    {
      "id": "1-12_msg_011",
      "type": 1,
      "content": "我还没回",
      "delay": 0,
      "next": "1-12_msg_012"
    },
    {
      "id": "1-12_msg_012",
      "type": 1,
      "content": "就是",
      "delay": 0,
      "next": "1-12_msg_013"
    },
    {
      "id": "1-12_msg_013",
      "type": 1,
      "content": "有点突然",
      "delay": 0,
      "next": "1-12_msg_014"
    },
