      "id": "1-12_msg_006",
      "type": 1,
      "content": "她问我",
      "delay": 0,
      "next": "1-12_msg_007"
    },
    {
      "id": "1-12_msg_007",
      "type": 1,
      "content": "\"明天有空吗，要不要一起去看个家具展\"",
      "delay": 0,
      "next": "1-12_msg_008"
    },
