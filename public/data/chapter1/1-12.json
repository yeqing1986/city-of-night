    {
      "id": "1-12_msg_026",
      "type": 1,
      "content": "她会直接说",
      "delay": 0,
      "next": "1-12_msg_027"
    },
    {
      "id": "1-12_msg_027",
      "type": 1,
      "content": "\"明天你要带孩子\"",
      "delay": 0,
      "next": "1-12_msg_028"
    },
