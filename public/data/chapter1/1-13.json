{
  "sceneId": "1-13",
  "title": "早晨的冲突",
  "nodes": [
    {
      "id": "1-13_msg_001",
      "type": 1,
      "content": "小七",
      "delay": 0,
      "next": "1-13_msg_002"
    },
    {
      "id": "1-13_msg_002",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-13_msg_003"
    },
    {
      "id": "1-13_msg_003",
      "type": 1,
      "content": "早上跟老婆吵架了",
      "delay": 0,
      "next": "1-13_msg_004"
    },
    {
      "id": "1-13_msg_004",
      "type": 1,
      "content": "因为今天",
      "delay": 0,
      "next": "1-13_msg_005"
    },
    {
      "id": "1-13_msg_005",
      "type": 1,
      "content": "她说",
      "delay": 0,
      "next": "1-13_msg_006"
    },
    {
      "id": "1-13_msg_006",
      "type": 1,
      "content": "\"你今天哪里都别去了，在家带孩子\"",
      "delay": 0,
      "next": "1-13_msg_007"
    },
    {
      "id": "1-13_msg_007",
      "type": 1,
      "content": "我说",
      "delay": 0,
      "next": "1-13_msg_008"
    },
    {
      "id": "1-13_msg_008",
      "type": 1,
      "content": "\"我明天要上班，今天想休息\"",
      "delay": 0,
      "next": "1-13_msg_009"
    },
    {
      "id": "1-13_msg_009",
      "type": 1,
      "content": "然后",
      "delay": 0,
      "next": "1-13_msg_010"
    },
    {
      "id": "1-13_msg_010",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-13_msg_011"
    },
    {
      "id": "1-13_msg_011",
      "type": 1,
      "content": "就吵起来了",
      "delay": 0,
      "next": "1-13_msg_012"
    },
    {
      "id": "1-13_msg_012",
      "type": 1,
      "content": "她不同意",
      "delay": 0,
      "next": "1-13_msg_013"
    },
    {
      "id": "1-13_msg_013",
      "type": 1,
      "content": "说",
      "delay": 0,
      "next": "1-13_msg_014"
    },
    {
      "id": "1-13_msg_014",
      "type": 1,
      "content": "\"我带了一周了，周末我想休息\"",
      "delay": 0,
      "next": "1-13_msg_015"
    },
    {
      "id": "1-13_msg_015",
      "type": 1,
      "content": "我说",
      "delay": 0,
      "next": "1-13_msg_016"
    },
    {
      "id": "1-13_msg_016",
      "type": 1,
      "content": "\"我上了一周班了，周末我也想休息\"",
      "delay": 0,
      "next": "1-13_msg_017"
    },
    {
      "id": "1-13_msg_017",
      "type": 1,
      "content": "然后",
      "delay": 0,
      "next": "1-13_msg_018"
    },
    {
      "id": "1-13_msg_018",
      "type": 1,
      "content": "她说",
      "delay": 0,
      "next": "1-13_msg_019"
    },
    {
      "id": "1-13_msg_019",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-13_msg_020"
    },
    {
      "id": "1-13_msg_020",
      "type": 1,
      "content": "\"那你上班轻松，我带孩子辛苦\"",
      "delay": 0,
      "next": "1-13_msg_021"
    },
    {
      "id": "1-13_msg_021",
      "type": 1,
      "content": "不轻松",
      "delay": 0,
      "next": "1-13_msg_022"
    },
    {
      "id": "1-13_msg_022",
      "type": 1,
      "content": "但她觉得",
      "delay": 0,
      "next": "1-13_msg_023"
    },
    {
      "id": "1-13_msg_023",
      "type": 1,
      "content": "我上班就是坐着",
      "delay": 0,
      "next": "1-13_msg_024"
    },
    {
      "id": "1-13_msg_024",
      "type": 1,
      "content": "她带孩子是体力活",
      "delay": 0,
      "next": "1-13_msg_025"
    },
    {
      "id": "1-13_msg_025",
      "type": 1,
      "content": "然后",
      "delay": 0,
      "next": "1-13_msg_026"
    },
    {
      "id": "1-13_msg_026",
      "type": 1,
      "content": "我就",
      "delay": 0,
      "next": "1-13_msg_027"
    },
    {
      "id": "1-13_msg_027",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-13_msg_028"
    },
    {
      "id": "1-13_msg_028",
      "type": 1,
      "content": "不说话了",
      "delay": 0,
      "next": "1-13_msg_029"
    },
    {
      "id": "1-13_msg_029",
      "type": 1,
      "content": "默认了",
      "delay": 0,
      "next": "1-13_msg_030"
    },
    {
      "id": "1-13_msg_030",
      "type": 1,
      "content": "也许她说得对",
      "delay": 0,
      "next": "1-13_msg_031"
    },
    {
      "id": "1-13_msg_031",
      "type": 1,
      "content": "我上班确实",
      "delay": 0,
      "next": "1-13_msg_032"
    },
    {
      "id": "1-13_msg_032",
      "type": 1,
      "content": "比她轻松",
      "delay": 0,
      "next": "1-13_msg_033"
    },
    {
      "id": "1-13_msg_033",
      "type": 1,
      "content": "然后",
      "delay": 0,
      "next": "1-13_msg_034"
    },
    {
      "id": "1-13_msg_034",
      "type": 1,
      "content": "我就",
      "delay": 0,
      "next": "1-13_msg_035"
    },
    {
      "id": "1-13_msg_035",
      "type": 1,
      "content": "在家带孩子了",
      "delay": 0
    }
  ]
}