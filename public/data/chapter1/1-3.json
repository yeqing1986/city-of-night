    },
    {
      "id": "1-3_msg_009",
      "type": 1,
      "content": "挺顺利的",
      "delay": 0,
      "next": "1-3_msg_010"
    },
    {
      "id": "1-3_msg_010",
      "type": 1,
      "content": "领导表扬了我",
      "delay": 0,
      "next": "1-3_msg_011"
    },
    {
      "id": "1-3_msg_011",
      "type": 1,
      "content": "说上个季度的业绩不错",
      "delay": 0,
      "next": "1-3_msg_012"
    },
    {
      "id": "1-3_msg_012",
      "type": 1,
      "content": "可能下季度会升职",
      "delay": 0,
      "next": "1-3_msg_013"
    },
    {
      "id": "1-3_msg_013",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-3_msg_014"
    },
    {
      "id": "1-3_msg_014",
      "type": 1,
      "content": "当区域经理",
      "delay": 0,
      "next": "1-3_msg_015"
    },
    {
      "id": "1-3_msg_015",
      "type": 1,
      "content": "开心",
      "delay": 0,
      "next": "1-3_msg_016"
    },
    {
      "id": "1-3_msg_016",
      "type": 1,
      "content": "当然开心",
      "delay": 0,
      "next": "1-3_msg_017"
    },
    {
      "id": "1-3_msg_017",
      "type": 1,
      "content": "升职意味着加薪",
      "delay": 0,
      "next": "1-3_msg_018"
    },
    {
      "id": "1-3_msg_018",
      "type": 1,
      "content": "压力也更大",
      "delay": 0,
      "next": "1-3_msg_019"
    },
    {
      "id": "1-3_msg_019",
      "type": 1,
      "content": "但",
      "delay": 0,
      "next": "1-3_msg_020"
    },
    {
      "id": "1-3_msg_020",
      "type": 1,
      "content": "怎么说",
      "delay": 0,
      "next": "1-3_msg_021"
    },
    {
      "id": "1-3_msg_021",
      "type": 1,
      "content": "开心的时候",
      "delay": 0,
      "next": "1-3_msg_022"
    },
    {
      "id": "1-3_msg_022",
      "type": 1,
      "content": "想跟人分享",
      "delay": 0,
      "next": "1-3_msg_023"
    },
    {
      "id": "1-3_msg_023",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-3_msg_024"
    },
    {
      "id": "1-3_msg_024",
      "type": 1,
      "content": "但不知道跟谁说",
      "delay": 0,
      "next": "1-3_msg_025"
    },
    {
      "id": "1-3_msg_025",
      "type": 1,
      "content": "老婆",
      "delay": 0,
      "next": "1-3_msg_026"
    },
    {
      "id": "1-3_msg_026",
      "type": 1,
      "content": "她可能不在意",
      "delay": 0,
      "next": "1-3_msg_027"
    },
    {
      "id": "1-3_msg_027",
      "type": 1,
      "content": "或者说",
      "delay": 0,
      "next": "1-3_msg_028"
    },
    {
      "id": "1-3_msg_028",
      "type": 1,
      "content": "她在意的是",
      "delay": 0,
      "next": "1-3_msg_029"
    },
    {
      "id": "1-3_msg_029",
      "type": 1,
      "content": "升职以后",
      "delay": 0,
      "next": "1-3_msg_030"
    },
    {
      "id": "1-3_msg_030",
      "type": 1,
      "content": "能不能多赚点钱",
      "delay": 0,
      "next": "1-3_msg_031"
    },
    {
      "id": "1-3_msg_031",
      "type": 1,
      "content": "而不是",
      "delay": 0,
      "next": "1-3_msg_032"
    },
    {
      "id": "1-3_msg_032",
      "type": 1,
      "content": "我努力了这么久",
      "delay": 0,
      "next": "1-3_msg_033"
    },
    {
      "id": "1-3_msg_033",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-3_msg_034"
    },
    {
      "id": "1-3_msg_034",
      "type": 1,
      "content": "终于被看见了",
      "delay": 0,
      "next": "1-3_msg_035"
    },
    {
      "id": "1-3_msg_035",
      "type": 1,
      "content": "差不多",
      "delay": 0,
      "next": "1-3_msg_036"
    },
    {
      "id": "1-3_msg_036",
      "type": 1,
      "content": "就是那种",
      "delay": 0,
      "next": "1-3_msg_037"
    },
    {
      "id": "1-3_msg_037",
      "type": 1,
      "content": "你做了什么",
      "delay": 0,
      "next": "1-3_msg_038"
    },
    {
      "id": "1-3_msg_038",
      "type": 1,
      "content": "有人看见了",
      "delay": 0,
      "next": "1-3_msg_039"
    },
    {
      "id": "1-3_msg_039",
      "type": 1,
      "content": "然后说一句",
      "delay": 0,
      "next": "1-3_msg_040"
    },
    {
      "id": "1-3_msg_040",
      "type": 1,
      "content": "\"你做得很好\"",
      "delay": 0,
      "next": "1-3_msg_041"
    },
    {
      "id": "1-3_msg_041",
      "type": 1,
      "content": "就这么简单",
      "delay": 0,
      "next": "1-3_msg_042"
    },
    {
      "id": "1-3_msg_042",
      "type": 1,
      "content": "但",
      "delay": 0,
      "next": "1-3_msg_043"
    },
    {
      "id": "1-3_msg_043",
      "type": 1,
      "content": "在家里",
      "delay": 0,
      "next": "1-3_msg_044"
    },
    {
      "id": "1-3_msg_044",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-3_msg_045"
    },
    {
      "id": "1-3_msg_045",
      "type": 1,
      "content": "好像没有人会说这句话",
      "delay": 0,
      "next": "1-3_msg_046"
    },
    {
      "id": "1-3_msg_046",
      "type": 1,
      "content": "有点复杂",
      "delay": 0,
      "next": "1-3_msg_047"
    },
    {
      "id": "1-3_msg_047",
      "type": 1,
      "content": "开心是开心",
      "delay": 0,
      "next": "1-3_msg_048"
    },
    {
      "id": "1-3_msg_048",
      "type": 1,
      "content": "但开心完了以后",
      "delay": 0,
      "next": "1-3_msg_049"
    },
    {
      "id": "1-3_msg_049",
      "type": 1,
      "content": "就没有然后了",
      "delay": 0,
      "next": "1-3_msg_050"
    },
    {
      "id": "1-3_msg_050",
      "type": 1,
      "content": "回家了",
      "delay": 0,
      "next": "1-3_msg_051"
    },
    {
      "id": "1-3_msg_051",
      "type": 1,
      "content": "还是各干各的",
      "delay": 0,
      "next": "1-3_msg_052"
    },
    {
      "id": "1-3_msg_052",
      "type": 1,
      "content": "这一天",
      "delay": 0,
      "next": "1-3_msg_053"
    },
    {
      "id": "1-3_msg_053",
      "type": 1,
      "content": "就这样过去了",
      "delay": 0,
      "next": "1-3_msg_054"
    },
    {
      "id": "1-3_msg_054",
      "type": 1,
      "content": "没有人在意",
      "delay": 0,
      "next": "1-3_msg_055"
    },
    {
      "id": "1-3_msg_055",
      "type": 1,
      "content": "你今天发生了什么",
      "delay": 0
