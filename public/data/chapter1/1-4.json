{
  "sceneId": "1-4",
  "title": "同事闲聊",
  "nodes": [
    {
      "id": "1-4_msg_001",
      "type": 1,
      "content": "小七",
      "delay": 0,
      "next": "1-4_msg_002"
    },
    {
      "id": "1-4_msg_002",
      "type": 1,
      "content": "刚才午休",
      "delay": 0,
      "next": "1-4_msg_003"
    },
    {
      "id": "1-4_msg_003",
      "type": 1,
      "content": "几个同事在聊天",
      "delay": 0,
      "next": "1-4_msg_004"
    },
    {
      "id": "1-4_msg_004",
      "type": 1,
      "content": "说周末要去哪玩",
      "delay": 0,
      "next": "1-4_msg_005"
    },
    {
      "id": "1-4_msg_005",
      "type": 1,
      "content": "我就站在旁边听",
      "delay": 0,
      "next": "1-4_msg_006"
    },
    {
      "id": "1-4_msg_006",
      "type": 1,
      "content": "也没有人问我",
      "delay": 0,
      "next": "1-4_msg_007"
    },
    {
      "id": "1-4_msg_007",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-4_msg_008"
    },
    {
      "id": "1-4_msg_008",
      "type": 1,
      "content": "\"叶晓阳，你去不去\"",
      "delay": 0,
      "next": "1-4_msg_009"
    },
    {
      "id": "1-4_msg_009",
      "type": 1,
      "content": "想",
      "delay": 0,
      "next": "1-4_msg_010"
    },
    {
      "id": "1-4_msg_010",
      "type": 1,
      "content": "但又不知道怎么说",
      "delay": 0,
      "next": "1-4_msg_011"
    },
    {
      "id": "1-4_msg_011",
      "type": 1,
      "content": "就是那种",
      "delay": 0,
      "next": "1-4_msg_012"
    },
    {
      "id": "1-4_msg_012",
      "type": 1,
      "content": "好像我不属于",
      "delay": 0,
      "next": "1-4_msg_013"
    },
    {
      "id": "1-4_msg_013",
      "type": 1,
      "content": "他们的圈子",
      "delay": 0,
      "next": "1-4_msg_014"
    },
    {
      "id": "1-4_msg_014",
      "type": 1,
      "content": "他们聊得热热闹闹的",
      "delay": 0,
      "next": "1-4_msg_015"
    },
    {
      "id": "1-4_msg_015",
      "type": 1,
      "content": "我就在旁边",
      "delay": 0,
      "next": "1-4_msg_016"
    },
    {
      "id": "1-4_msg_016",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-4_msg_017"
    },
    {
      "id": "1-4_msg_017",
      "type": 1,
      "content": "像个局外人",
      "delay": 0,
      "next": "1-4_msg_018"
    },
    {
      "id": "1-4_msg_018",
      "type": 1,
      "content": "类似",
      "delay": 0,
      "next": "1-4_msg_019"
    },
    {
      "id": "1-4_msg_019",
      "type": 1,
      "content": "就是那种",
      "delay": 0,
      "next": "1-4_msg_020"
    },
    {
      "id": "1-4_msg_020",
      "type": 1,
      "content": "你存在",
      "delay": 0,
      "next": "1-4_msg_021"
    },
    {
      "id": "1-4_msg_021",
      "type": 1,
      "content": "但好像没有人注意到你",
      "delay": 0,
      "next": "1-4_msg_022"
    },
    {
      "id": "1-4_msg_022",
      "type": 1,
      "content": "你说话",
      "delay": 0,
      "next": "1-4_msg_023"
    },
    {
      "id": "1-4_msg_023",
      "type": 1,
      "content": "也没有人回应",
      "delay": 0,
      "next": "1-4_msg_024"
    },
    {
      "id": "1-4_msg_024",
      "type": 1,
      "content": "久而久之",
      "delay": 0,
      "next": "1-4_msg_025"
    },
    {
      "id": "1-4_msg_025",
      "type": 1,
      "content": "就不说话了",
      "delay": 0,
      "next": "1-4_msg_026"
    },
    {
      "id": "1-4_msg_026",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-4_msg_027"
    },
    {
      "id": "1-4_msg_027",
      "type": 1,
      "content": "习惯了",
      "delay": 0,
      "next": "1-4_msg_028"
    },
    {
      "id": "1-4_msg_028",
      "type": 1,
      "content": "以前",
      "delay": 0,
      "next": "1-4_msg_029"
    },
    {
      "id": "1-4_msg_029",
      "type": 1,
      "content": "不是这样的",
      "delay": 0,
      "next": "1-4_msg_030"
    },
    {
      "id": "1-4_msg_030",
      "type": 1,
      "content": "以前很活泼",
      "delay": 0,
      "next": "1-4_msg_031"
    },
    {
      "id": "1-4_msg_031",
      "type": 1,
      "content": "喜欢开玩笑",
      "delay": 0,
      "next": "1-4_msg_032"
    },
    {
      "id": "1-4_msg_032",
      "type": 1,
      "content": "喜欢跟人聊天",
      "delay": 0,
      "next": "1-4_msg_033"
    },
    {
      "id": "1-4_msg_033",
      "type": 1,
      "content": "但结婚以后",
      "delay": 0,
      "next": "1-4_msg_034"
    },
    {
      "id": "1-4_msg_034",
      "type": 1,
      "content": "慢慢就变了",
      "delay": 0,
      "next": "1-4_msg_035"
    },
    {
      "id": "1-4_msg_035",
      "type": 1,
      "content": "不知道为什么",
      "delay": 0,
      "next": "1-4_msg_036"
    },
    {
      "id": "1-4_msg_036",
      "type": 1,
      "content": "可能是",
      "delay": 0,
      "next": "1-4_msg_037"
    },
    {
      "id": "1-4_msg_037",
      "type": 1,
      "content": "家里的事情太多",
      "delay": 0,
      "next": "1-4_msg_038"
    },
    {
      "id": "1-4_msg_038",
      "type": 1,
      "content": "精力都在工作上",
      "delay": 0,
      "next": "1-4_msg_039"
    },
    {
      "id": "1-4_msg_039",
      "type": 1,
      "content": "回家就想休息",
      "delay": 0,
      "next": "1-4_msg_040"
    },
    {
      "id": "1-4_msg_040",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-4_msg_041"
    },
    {
      "id": "1-4_msg_041",
      "type": 1,
      "content": "不想说话了",
      "delay": 0,
      "next": "1-4_msg_042"
    },
    {
      "id": "1-4_msg_042",
      "type": 1,
      "content": "都变了",
      "delay": 0,
      "next": "1-4_msg_043"
    },
    {
      "id": "1-4_msg_043",
      "type": 1,
      "content": "她变了",
      "delay": 0,
      "next": "1-4_msg_044"
    },
    {
      "id": "1-4_msg_044",
      "type": 1,
      "content": "我也变了",
      "delay": 0,
      "next": "1-4_msg_045"
    },
    {
      "id": "1-4_msg_045",
      "type": 1,
      "content": "以前刚结婚的时候",
      "delay": 0,
      "next": "1-4_msg_046"
    },
    {
      "id": "1-4_msg_046",
      "type": 1,
      "content": "还会一起出去吃饭",
      "delay": 0,
      "next": "1-4_msg_047"
    },
    {
      "id": "1-4_msg_047",
      "type": 1,
      "content": "看电影",
      "delay": 0,
      "next": "1-4_msg_048"
    },
    {
      "id": "1-4_msg_048",
      "type": 1,
      "content": "后来有了糖糖",
      "delay": 0,
      "next": "1-4_msg_049"
    },
    {
      "id": "1-4_msg_049",
      "type": 1,
      "content": "她就忙着照顾孩子",
      "delay": 0,
      "next": "1-4_msg_050"
    },
    {
      "id": "1-4_msg_050",
      "type": 1,
      "content": "我忙着赚钱",
      "delay": 0,
      "next": "1-4_msg_051"
    },
    {
      "id": "1-4_msg_051",
      "type": 1,
      "content": "两个人就",
      "delay": 0,
      "next": "1-4_msg_052"
    },
    {
      "id": "1-4_msg_052",
      "type": 1,
      "content": "各忙各的",
      "delay": 0,
      "next": "1-4_msg_053"
    },
    {
      "id": "1-4_msg_053",
      "type": 1,
      "content": "慢慢的",
      "delay": 0,
      "next": "1-4_msg_054"
    },
    {
      "id": "1-4_msg_054",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-4_msg_055"
    },
    {
      "id": "1-4_msg_055",
      "type": 1,
      "content": "就变成这样了",
      "delay": 0,
      "next": "1-4_msg_056"
    },
    {
      "id": "1-4_msg_056",
      "type": 1,
      "content": "想过",
      "delay": 0,
      "next": "1-4_msg_057"
    },
    {
      "id": "1-4_msg_057",
      "type": 1,
      "content": "但不知道怎么打破",
      "delay": 0,
      "next": "1-4_msg_058"
    },
    {
      "id": "1-4_msg_058",
      "type": 1,
      "content": "说什么呢",
      "delay": 0,
      "next": "1-4_msg_059"
    },
    {
      "id": "1-4_msg_059",
      "type": 1,
      "content": "说\"我觉得我们疏远了\"",
      "delay": 0,
      "next": "1-4_msg_060"
    },
    {
      "id": "1-4_msg_060",
      "type": 1,
      "content": "她会说\"你想太多了\"",
      "delay": 0,
      "next": "1-4_msg_061"
    },
    {
      "id": "1-4_msg_061",
      "type": 1,
      "content": "说\"我想跟你聊聊\"",
      "delay": 0,
      "next": "1-4_msg_062"
    },
    {
      "id": "1-4_msg_062",
      "type": 1,
      "content": "她会说\"聊什么，有什么好聊的\"",
      "delay": 0,
      "next": "1-4_msg_063"
    },
    {
      "id": "1-4_msg_063",
      "type": 1,
      "content": "然后就",
      "delay": 0,
      "next": "1-4_msg_064"
    },
    {
      "id": "1-4_msg_064",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-4_msg_065"
    },
    {
      "id": "1-4_msg_065",
      "type": 1,
      "content": "没有然后了",
      "delay": 0,
      "next": "1-4_msg_066"
    },
    {
      "id": "1-4_msg_066",
      "type": 1,
      "content": "试过",
      "delay": 0,
      "next": "1-4_msg_067"
    },
    {
      "id": "1-4_msg_067",
      "type": 1,
      "content": "约她看电影",
      "delay": 0,
      "next": "1-4_msg_068"
    },
    {
      "id": "1-4_msg_068",
      "type": 1,
      "content": "她说没时间",
      "delay": 0,
      "next": "1-4_msg_069"
    },
    {
      "id": "1-4_msg_069",
      "type": 1,
      "content": "要带孩子",
      "delay": 0,
      "next": "1-4_msg_070"
    },
    {
      "id": "1-4_msg_070",
      "type": 1,
      "content": "约她出去吃饭",
      "delay": 0,
      "next": "1-4_msg_071"
    },
    {
      "id": "1-4_msg_071",
      "type": 1,
      "content": "她说太累了",
      "delay": 0,
      "next": "1-4_msg_072"
    },
    {
      "id": "1-4_msg_072",
      "type": 1,
      "content": "想早点休息",
      "delay": 0,
      "next": "1-4_msg_073"
    },
    {
      "id": "1-4_msg_073",
      "type": 1,
      "content": "约她散步",
      "delay": 0,
      "next": "1-4_msg_074"
    },
    {
      "id": "1-4_msg_074",
      "type": 1,
      "content": "她说还有家务要做",
      "delay": 0,
      "next": "1-4_msg_075"
    },
    {
      "id": "1-4_msg_075",
      "type": 1,
      "content": "反正",
      "delay": 0,
      "next": "1-4_msg_076"
    },
    {
      "id": "1-4_msg_076",
      "type": 1,
      "content": "每次",
      "delay": 0,
      "next": "1-4_msg_077"
    },
    {
      "id": "1-4_msg_077",
      "type": 1,
      "content": "（等待用户输入）",
      "delay": 0,
      "next": "1-4_msg_078"
    },
    {
      "id": "1-4_msg_078",
      "type": 1,
      "content": "都有理由",
      "delay": 0,
      "next": "1-4_msg_079"
    },
    {
      "id": "1-4_msg_079",
      "type": 1,
      "content": "不知道",
      "delay": 0,
      "next": "1-4_msg_080"
    },
    {
      "id": "1-4_msg_080",
      "type": 1,
      "content": "不想去想",
      "delay": 0,
      "next": "1-4_msg_081"
    },
    {
      "id": "1-4_msg_081",
      "type": 1,
      "content": "想了也没用",
      "delay": 0,
      "next": "1-4_msg_082"
    },
    {
      "id": "1-4_msg_082",
      "type": 1,
      "content": "想了只会更烦",
      "delay": 0,
      "next": "1-4_msg_083"
    },
    {
      "id": "1-4_msg_083",
      "type": 1,
      "content": "算了",
      "delay": 0,
      "next": "1-4_msg_084"
    },
    {
      "id": "1-4_msg_084",
      "type": 1,
      "content": "就这样吧",
      "delay": 0
    }
  ]
